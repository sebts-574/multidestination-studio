diff --git a/src/presets/multidestination.ts b/src/presets/multidestination.ts
new file mode 100644
index 0000000..d1456ba
--- /dev/null
+++ b/src/presets/multidestination.ts
@@ -0,0 +1,265 @@
+import { CompanionPresetDefinitions, CompanionPresetSection } from '@companion-module/base'
+import type OBSInstance from '../main.js'
+import type { OBSInstanceTypes } from '../main.js'
+import { baseStyle, styleActive, stylePreview, styleProgram } from './style.js'
+import { groupVariableId } from '../multidestination.js'
+import { validName } from '../utils.js'
+
+/**
+ * Multidestination Studio presets: shown only when the OBS plugin answers its vendor requests. They
+ * drive the studio (every destination) rather than the OBS main canvas.
+ */
+export function getMultidestinationPresets(self: OBSInstance): {
+	presets: CompanionPresetDefinitions<OBSInstanceTypes>
+	sections: CompanionPresetSection<OBSInstanceTypes>[]
+} {
+	const presets: CompanionPresetDefinitions<OBSInstanceTypes> = {}
+	const state = self.multidestination
+	if (!state.available) return { presets, sections: [] }
+
+	const sceneFeedbacks = [
+		{
+			feedbackId: 'mdsScene' as const,
+			options: { scene: { value: '$(local:scene)', isExpression: true }, state: 'preview' as const },
+			style: stylePreview(),
+		},
+		{
+			feedbackId: 'mdsScene' as const,
+			options: { scene: { value: '$(local:scene)', isExpression: true }, state: 'program' as const },
+			style: styleProgram(),
+		},
+	]
+
+	presets['tmp_mdsScenePreview'] = {
+		type: 'simple',
+		name: 'Scene to Preview',
+		localVariables: [{ variableType: 'simple', variableName: 'scene', startupValue: '', headline: 'Scene name' }],
+		style: baseStyle({ text: '$(local:scene)' }),
+		steps: [
+			{
+				down: [{ actionId: 'mdsPreviewScene', options: { scene: { value: '$(local:scene)', isExpression: true } } }],
+				up: [],
+			},
+		],
+		feedbacks: sceneFeedbacks,
+	}
+
+	presets['tmp_mdsSceneProgram'] = {
+		type: 'simple',
+		name: 'Scene to Program',
+		localVariables: [{ variableType: 'simple', variableName: 'scene', startupValue: '', headline: 'Scene name' }],
+		style: baseStyle({ text: '$(local:scene)' }),
+		steps: [
+			{
+				down: [{ actionId: 'mdsProgramScene', options: { scene: { value: '$(local:scene)', isExpression: true } } }],
+				up: [],
+			},
+		],
+		feedbacks: sceneFeedbacks,
+	}
+
+	presets['mdsTransition'] = {
+		type: 'simple',
+		keywords: ['take', 'auto'],
+		name: 'Transition (Preview to Program)',
+		style: baseStyle({ text: 'Transition' }),
+		steps: [
+			{
+				down: [{ actionId: 'mdsTransition', options: { transition: '', customDuration: false, duration: 300 } }],
+				up: [],
+			},
+		],
+		feedbacks: [],
+	}
+
+	presets['tmp_mdsQuickTransition'] = {
+		type: 'simple',
+		name: 'Transition With',
+		localVariables: [
+			{ variableType: 'simple', variableName: 'transition', startupValue: '', headline: 'Transition name' },
+		],
+		style: baseStyle({ text: '$(local:transition)' }),
+		steps: [
+			{
+				down: [
+					{
+						actionId: 'mdsTransition',
+						options: {
+							transition: { value: '$(local:transition)', isExpression: true },
+							customDuration: false,
+							duration: 300,
+						},
+					},
+				],
+				up: [],
+			},
+		],
+		feedbacks: [],
+	}
+
+	presets['mdsAfterTransition'] = {
+		type: 'simple',
+		keywords: ['swap', 'after transition'],
+		name: 'After a Transition (toggle)',
+		style: baseStyle({ text: 'Swap\nPGM→PVW' }),
+		steps: [{ down: [{ actionId: 'mdsAfterTransition', options: { mode: 'toggle' } }], up: [] }],
+		feedbacks: [{ feedbackId: 'mdsAfterTransition', options: {}, style: styleActive() }],
+	}
+
+	presets['mdsDestinationsShown'] = {
+		type: 'simple',
+		keywords: ['destinations shown', 'show all'],
+		name: 'Destinations Shown (toggle)',
+		style: baseStyle({ text: 'All\nDestinations' }),
+		steps: [{ down: [{ actionId: 'mdsDestinationsShown', options: { mode: 'toggle' } }], up: [] }],
+		feedbacks: [{ feedbackId: 'mdsDestinationsShown', options: {}, style: styleActive() }],
+	}
+
+	const sceneValues = state.scenes.map((s) => ({ name: s, value: s }))
+	const transitionValues = state.transitions.map((t) => ({ name: t, value: t }))
+
+	const definitions: CompanionPresetSection<OBSInstanceTypes>['definitions'] = [
+		{
+			id: 'mds-scenes-preview',
+			name: 'Scene to Preview',
+			type: 'template',
+			presetId: 'tmp_mdsScenePreview',
+			templateVariableName: 'scene',
+			templateValues: sceneValues,
+		},
+		{
+			id: 'mds-scenes-program',
+			name: 'Scene to Program',
+			type: 'template',
+			presetId: 'tmp_mdsSceneProgram',
+			templateVariableName: 'scene',
+			templateValues: sceneValues,
+		},
+		{ id: 'mds-transition', name: 'Transition', type: 'simple', presets: ['mdsTransition'] },
+		{
+			id: 'mds-transitions',
+			name: 'Transition With',
+			type: 'template',
+			presetId: 'tmp_mdsQuickTransition',
+			templateVariableName: 'transition',
+			templateValues: transitionValues,
+		},
+		{
+			id: 'mds-settings',
+			name: 'Settings',
+			type: 'simple',
+			presets: ['mdsAfterTransition', 'mdsDestinationsShown'],
+		},
+	]
+
+	if (state.cuesEnabled) {
+		presets['tmp_mdsCue'] = {
+			type: 'simple',
+			name: 'Cue to Preview',
+			localVariables: [{ variableType: 'simple', variableName: 'cue', startupValue: '', headline: 'Cue name' }],
+			style: baseStyle({ text: '$(local:cue)' }),
+			steps: [
+				{
+					down: [
+						{
+							actionId: 'mdsCue',
+							options: { mode: 'preview', cue: { value: '$(local:cue)', isExpression: true } },
+						},
+					],
+					up: [],
+				},
+			],
+			feedbacks: [
+				{
+					feedbackId: 'mdsCue',
+					options: { cue: { value: '$(local:cue)', isExpression: true }, state: 'preview' },
+					style: stylePreview(),
+				},
+				{
+					feedbackId: 'mdsCue',
+					options: { cue: { value: '$(local:cue)', isExpression: true }, state: 'running' },
+					style: styleProgram(),
+				},
+			],
+		}
+		presets['mdsCueStop'] = {
+			type: 'simple',
+			name: 'Stop Cue (fade to black)',
+			style: baseStyle({ text: 'Stop\nCue' }),
+			steps: [{ down: [{ actionId: 'mdsCue', options: { mode: 'stop', cue: '' } }], up: [] }],
+			feedbacks: [],
+		}
+		definitions.push(
+			{
+				id: 'mds-cues',
+				name: 'Cue to Preview',
+				type: 'template',
+				presetId: 'tmp_mdsCue',
+				templateVariableName: 'cue',
+				templateValues: state.cues.map((c) => ({ name: c, value: c })),
+			},
+			{ id: 'mds-cue-stop', name: 'Stop Cue', type: 'simple', presets: ['mdsCueStop', 'mdsCueStatus'] },
+		)
+		presets['mdsCueStatus'] = {
+			type: 'simple',
+			keywords: ['cue', 'status', 'media', 'auto-follow'],
+			name: 'Running Cue Status',
+			style: baseStyle({ text: '$(obs:mds_running_cue)\n$(obs:mds_cue_status)' }),
+			steps: [{ down: [], up: [] }],
+			feedbacks: [],
+		}
+	}
+
+	/* One button per group (groups with the same name share it): shows the group name and the source
+	 * currently shown; each press shows the next source and hides the others. */
+	if (state.groups.length > 0) {
+		const groupPresets: string[] = []
+		for (const group of state.groups) {
+			const id = `mdsGroup_${groupVariableId(group.name)}`
+			presets[id] = {
+				type: 'simple',
+				keywords: ['group', 'source', 'cycle', group.name],
+				name: `Group ${group.name} (next source)`,
+				style: baseStyle({ text: `${group.name}\n$(obs:${groupVariableId(group.name)})` }),
+				steps: [
+					{
+						down: [{ actionId: 'mdsGroup', options: { mode: 'next', group: group.name, source: '' } }],
+						up: [],
+					},
+				],
+				feedbacks: [],
+			}
+			groupPresets.push(id)
+			// One button per source of the group: shows it (and hides the others), lit while shown.
+			for (const source of group.sources) {
+				const sourceId = `${id}_${validName(source)}`
+				presets[sourceId] = {
+					type: 'simple',
+					keywords: ['group', 'source', group.name, source],
+					name: `Group ${group.name}: show ${source}`,
+					style: baseStyle({ text: source }),
+					steps: [
+						{
+							down: [{ actionId: 'mdsGroup', options: { mode: 'select', group: group.name, source } }],
+							up: [],
+						},
+					],
+					feedbacks: [{ feedbackId: 'mdsGroupSource', options: { group: group.name, source }, style: styleActive() }],
+				}
+				groupPresets.push(sourceId)
+			}
+		}
+		definitions.push({ id: 'mds-groups', name: 'Group Source Selector', type: 'simple', presets: groupPresets })
+	}
+
+	const sections: CompanionPresetSection<OBSInstanceTypes>[] = [
+		{
+			id: 'multidestination',
+			name: 'Multidestination Studio',
+			keywords: ['multidestination', 'destinations', 'studio', 'cue'],
+			definitions,
+		},
+	]
+
+	return { presets, sections }
+}
