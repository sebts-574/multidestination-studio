@@ -0,0 +1,213 @@
+import { CompanionPresetDefinitions, CompanionPresetSection } from '@companion-module/base'
+import type OBSInstance from '../main.js'
+import type { OBSInstanceTypes } from '../main.js'
+import { baseStyle, styleActive, stylePreview, styleProgram } from './style.js'
+
+/**
+ * Multidestination Studio presets: shown only when the OBS plugin answers its vendor requests. They
+ * drive the studio (every destination) rather than the OBS main canvas.
+ */
+export function getMultidestinationPresets(self: OBSInstance): {
+	presets: CompanionPresetDefinitions<OBSInstanceTypes>
+	sections: CompanionPresetSection<OBSInstanceTypes>[]
+} {
+	const presets: CompanionPresetDefinitions<OBSInstanceTypes> = {}
+	const state = self.multidestination
+	if (!state.available) return { presets, sections: [] }
+
+	const sceneFeedbacks = [
+		{
+			feedbackId: 'mdsScene' as const,
+			options: { scene: { value: '$(local:scene)', isExpression: true }, state: 'preview' as const },
+			style: stylePreview(),
+		},
