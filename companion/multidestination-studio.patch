diff --git a/src/multidestination.ts b/src/multidestination.ts
new file mode 100644
index 0000000..f558a8d
--- /dev/null
+++ b/src/multidestination.ts
@@ -0,0 +1,220 @@
+import { createModuleLogger, type JsonObject } from '@companion-module/base'
+import type OBSInstance from './main.js'
+import { validName } from './utils.js'
+
+const logger = createModuleLogger('Multidestination')
+
+/** obs-websocket vendor name registered by the Multidestination Studio OBS plugin. */
+export const MDS_VENDOR = 'multidestination-studio'
+
+/** State of the Multidestination Studio plugin, read with its `GetState` vendor request. */
+export interface MultidestinationState {
+	available: boolean
+	previewScene: string
+	programScene: string
+	scenes: string[]
+	transitions: string[]
+	swapAfterTake: boolean
+	showAllDestinations: boolean
+	cuesEnabled: boolean
+	cues: string[]
+	previewCue: string
+	runningCue: string
+	/** Running cue: current step (1-based, 0 when idle) and step count. */
+	cueStep: number
+	cueSteps: number
+	/** 'pre_wait', 'post_wait', 'media' or '' */
+	cuePhase: string
+	/** Time left in the current wait, or in the followed media (ms). */
+	cueRemaining: number
+	cueMediaTime: number
+	cueMediaDuration: number
+	/** Source groups (one entry per group name), sources listed top to bottom. */
+	groups: MultidestinationGroup[]
+}
+
+export interface MultidestinationGroup {
+	name: string
+	sources: string[]
+	/** First visible source, '' when none is visible. */
+	current: string
+}
+
+export function emptyMultidestinationState(): MultidestinationState {
+	return {
+		available: false,
+		previewScene: '',
+		programScene: '',
+		scenes: [],
+		transitions: [],
+		swapAfterTake: true,
+		showAllDestinations: true,
+		cuesEnabled: false,
+		cues: [],
+		previewCue: '',
+		runningCue: '',
+		cueStep: 0,
+		cueSteps: 0,
+		cuePhase: '',
+		cueRemaining: 0,
+		cueMediaTime: 0,
+		cueMediaDuration: 0,
+		groups: [],
+	}
+}
+
+function num(value: unknown): number {
+	return typeof value === 'number' && Number.isFinite(value) ? value : 0
+}
+
+function parseGroups(list: unknown): MultidestinationGroup[] {
+	if (!Array.isArray(list)) return []
+	const groups: MultidestinationGroup[] = []
+	for (const item of list) {
+		if (!item || typeof item !== 'object') continue
+		const g = item as Record<string, unknown>
+		if (typeof g.groupName !== 'string') continue
+		groups.push({
+			name: g.groupName,
+			sources: names(g.sources, 'sourceName'),
+			current: typeof g.current === 'string' ? g.current : '',
+		})
+	}
+	return groups
+}
+
+/** m:ss */
+export function formatClock(ms: number): string {
+	const total = Math.max(0, Math.floor(ms / 1000))
+	return `${Math.floor(total / 60)}:${String(total % 60).padStart(2, '0')}`
+}
+
+/** Short status of the running cue, for a button: '2/5 ▶ 0:42' (media), '2/5 ⏱ 0:05' (wait), '' when idle. */
+export function cueStatusText(state: MultidestinationState): string {
+	if (!state.runningCue || state.cueStep <= 0) return ''
+	const step = `${state.cueStep}/${state.cueSteps}`
+	if (state.cuePhase === 'media') return `${step} ▶ ${formatClock(state.cueRemaining)}`
+	if (state.cuePhase === 'pre_wait' || state.cuePhase === 'post_wait') {
+		return `${step} ⏱ ${formatClock(state.cueRemaining)}`
+	}
+	return step
+}
+
+export function groupVariableId(group: string): string {
+	return `mds_group_${validName(group)}`
+}
+
+/** Variable definitions and values of the plugin state. */
+export function multidestinationVariableEntries(
+	state: MultidestinationState,
+): { id: string; name: string; value: string | number }[] {
+	if (!state.available) return []
+	const entries: { id: string; name: string; value: string | number }[] = [
+		{ id: 'mds_preview_scene', name: 'Multidestination Studio - Preview scene', value: state.previewScene },
+		{ id: 'mds_program_scene', name: 'Multidestination Studio - Program scene', value: state.programScene },
+		{ id: 'mds_preview_cue', name: 'Multidestination Studio - Cue in Preview', value: state.previewCue },
+		{ id: 'mds_running_cue', name: 'Multidestination Studio - Running cue', value: state.runningCue },
+		{
+			id: 'mds_cue_step',
+			name: 'Multidestination Studio - Running cue step (2/5)',
+			value: state.cueStep > 0 ? `${state.cueStep}/${state.cueSteps}` : '',
+		},
+		{
+			id: 'mds_cue_remaining',
+			name: 'Multidestination Studio - Time left in the current cue step (m:ss)',
+			value: state.cueStep > 0 ? formatClock(state.cueRemaining) : '',
+		},
+		{
+			id: 'mds_cue_media',
+			name: 'Multidestination Studio - Auto-follow media position (elapsed / total)',
+			value:
+				state.cuePhase === 'media' ? `${formatClock(state.cueMediaTime)} / ${formatClock(state.cueMediaDuration)}` : '',
+		},
+		{ id: 'mds_cue_status', name: 'Multidestination Studio - Running cue status', value: cueStatusText(state) },
+	]
+	for (const group of state.groups) {
+		entries.push({
+			id: groupVariableId(group.name),
+			name: `Multidestination Studio - Source shown in group ${group.name}`,
+			value: group.current,
+		})
+	}
+	return entries
+}
+
+/** Sends a request to the plugin. Resolves to its response data, or null if the plugin did not answer. */
+export async function multidestinationRequest(
+	self: OBSInstance,
+	requestType: string,
+	requestData: JsonObject,
+): Promise<JsonObject | null> {
+	const res = await self.obs.sendRequest('CallVendorRequest', { vendorName: MDS_VENDOR, requestType, requestData })
+	return res?.responseData ?? null
+}
+
+function names(list: unknown, key: string): string[] {
+	if (!Array.isArray(list)) return []
+	return list
+		.map((item) => (item && typeof item === 'object' ? (item as Record<string, unknown>)[key] : undefined))
+		.filter((name): name is string => typeof name === 'string')
+}
+
+/** Parses a `GetState` response. Exported for tests. */
+export function parseMultidestinationState(data: JsonObject | null): MultidestinationState {
+	if (!data || data.ok !== true) return emptyMultidestinationState()
+	return {
+		available: true,
+		previewScene: typeof data.previewScene === 'string' ? data.previewScene : '',
+		programScene: typeof data.programScene === 'string' ? data.programScene : '',
+		scenes: names(data.scenes, 'sceneName'),
+		transitions: names(data.transitions, 'transitionName'),
+		swapAfterTake: data.swapAfterTake !== false,
+		showAllDestinations: data.showAllDestinations !== false,
+		cuesEnabled: data.cuesEnabled === true,
+		cues: names(data.cues, 'cueName'),
+		previewCue: typeof data.previewCue === 'string' ? data.previewCue : '',
+		runningCue: typeof data.runningCue === 'string' ? data.runningCue : '',
+		cueStep: num(data.cueStep),
+		cueSteps: num(data.cueSteps),
+		cuePhase: typeof data.cuePhase === 'string' ? data.cuePhase : '',
+		cueRemaining: num(data.cueRemaining),
+		cueMediaTime: num(data.cueMediaTime),
+		cueMediaDuration: num(data.cueMediaDuration),
+		groups: parseGroups(data.groups),
+	}
+}
+
+const FEEDBACKS = ['mdsScene', 'mdsAfterTransition', 'mdsDestinationsShown', 'mdsCue', 'mdsGroupSource'] as const
+
+function groupsKey(groups: MultidestinationGroup[]): string {
+	return groups.map((g) => `${g.name}\t${g.sources.join('\t')}`).join('\n')
+}
+
+/** Re-reads the plugin state. Rebuilds the definitions when the plugin appears or its lists change. */
+export async function refreshMultidestination(self: OBSInstance): Promise<void> {
+	let data: JsonObject | null = null
+	try {
+		data = await multidestinationRequest(self, 'GetState', {})
+	} catch (error) {
+		logger.debug(`GetState failed (${String(error)})`)
+	}
+	const previous = self.multidestination ?? emptyMultidestinationState()
+	const next = parseMultidestinationState(data)
+	self.multidestination = next
+
+	if (next.available !== previous.available) {
+		logger.info(next.available ? 'Multidestination Studio detected' : 'Multidestination Studio not available')
+	}
+	const listsChanged =
+		next.available !== previous.available ||
+		next.cuesEnabled !== previous.cuesEnabled ||
+		next.scenes.join('\n') !== previous.scenes.join('\n') ||
+		next.transitions.join('\n') !== previous.transitions.join('\n') ||
+		next.cues.join('\n') !== previous.cues.join('\n') ||
+		groupsKey(next.groups) !== groupsKey(previous.groups)
+	if (listsChanged) self.updateActionsFeedbacksVariables()
+	const values: Record<string, string | number> = {}
+	for (const entry of multidestinationVariableEntries(next)) values[entry.id] = entry.value
+	if (Object.keys(values).length > 0) self.setVariableValues(values)
+	self.checkFeedbacks(...FEEDBACKS)
+}
