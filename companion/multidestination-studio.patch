+++ b/src/actions/multidestination.ts
@@ -0,0 +1,156 @@
+import { CompanionActionDefinitions, type CompanionInputFieldDropdown, type JsonObject } from '@companion-module/base'
+import type OBSInstance from '../main.js'
+import { multidestinationRequest } from '../multidestination.js'
+
+export type MultidestinationActionSchemas = {
+	mdsPreviewScene: { options: { scene: string } }
+	mdsProgramScene: { options: { scene: string } }
+	mdsTransition: { options: { transition: string; customDuration: boolean; duration: number } }
+	mdsAfterTransition: { options: { mode: 'toggle' | 'on' | 'off' } }
+	mdsDestinationsShown: { options: { mode: 'toggle' | 'on' | 'off' } }
+	mdsCue: { options: { mode: 'preview' | 'go' | 'stop'; cue: string } }
+}
+
+/** Choice list from the plugin state; custom values allow names set by expressions. */
+export function mdsDropdown<TKey extends string>(
+	id: TKey,
+	label: string,
+	values: string[],
+	extra: Partial<CompanionInputFieldDropdown<TKey>> = {},
+): CompanionInputFieldDropdown<TKey> {
+	return {
+		type: 'dropdown',
+		id,
+		label,
+		default: values[0] ?? '',
+		choices: values.map((v) => ({ id: v, label: v })),
+		allowCustom: true,
+		...extra,
+	}
+}
+
+const TOGGLE_MODE: CompanionInputFieldDropdown<'mode'> = {
+	type: 'dropdown',
+	id: 'mode',
+	label: 'Mode',
+	default: 'toggle',
+	choices: [
+		{ id: 'toggle', label: 'Toggle' },
+		{ id: 'on', label: 'On' },
+		{ id: 'off', label: 'Off' },
+	],
+	disableAutoExpression: true,
+}
+
+function toggleData(mode: 'toggle' | 'on' | 'off'): JsonObject {
+	return mode === 'toggle' ? {} : { value: mode === 'on' }
+}
+
+export function getMultidestinationActions(
+	self: OBSInstance,
+): CompanionActionDefinitions<MultidestinationActionSchemas> {
+	const state = self.multidestination
+	return {
+		mdsPreviewScene: {
+			name: 'Multidestination Studio - Scene to Preview',
+			description: 'Shows a scene in the Multidestination Studio Preview',
+			options: [mdsDropdown('scene', 'Scene', state.scenes)],
+			callback: async (action) => {
+				await multidestinationRequest(self, 'SetPreviewScene', { sceneName: action.options.scene })
+			},
+		},
+
+		mdsProgramScene: {
+			name: 'Multidestination Studio - Scene to Program',
+			description: 'Puts a scene on air on every unlocked destination it covers, with the current transition',
+			options: [mdsDropdown('scene', 'Scene', state.scenes)],
+			callback: async (action) => {
+				await multidestinationRequest(self, 'SetProgramScene', { sceneName: action.options.scene })
+			},
+		},
+
+		mdsTransition: {
+			name: 'Multidestination Studio - Transition',
+			description: 'Takes the Multidestination Studio Preview to Program, with the current or a chosen transition',
+			options: [
+				mdsDropdown('transition', 'Transition', ['', ...state.transitions], {
+					default: '',
+					choices: [
+						{ id: '', label: 'Current transition' },
+						...state.transitions.map((t) => ({ id: t, label: t })),
+					],
+				}),
+				{
+					type: 'checkbox',
+					disableAutoExpression: true,
+					label: 'Custom Duration',
+					id: 'customDuration',
+					default: false,
+				},
+				{
+					type: 'number',
+					label: 'Transition time (in ms)',
+					id: 'duration',
+					default: 300,
+					min: 0,
+					max: 20 * 1000,
+					clampValues: true,
+					isVisibleExpression: `$(options:customDuration)`,
+				},
+			],
+			callback: async (action) => {
+				const data: JsonObject = {}
+				if (action.options.transition) data.transitionName = action.options.transition
+				if (action.options.customDuration) data.duration = action.options.duration
+				await multidestinationRequest(self, 'Transition', data)
+			},
+		},
+
+		mdsAfterTransition: {
+			name: 'Multidestination Studio - After a Transition',
+			description: 'On: the previous Program returns to Preview after a transition. Off: the scene taken stays in Preview',
+			options: [TOGGLE_MODE],
+			callback: async (action) => {
+				await multidestinationRequest(self, 'SetAfterTransition', toggleData(action.options.mode))
+			},
+		},
+
+		mdsDestinationsShown: {
+			name: 'Multidestination Studio - Destinations Shown',
+			description: 'On: every destination is shown. Off: only the destinations of the selected scene',
+			options: [TOGGLE_MODE],
+			callback: async (action) => {
+				await multidestinationRequest(self, 'SetDestinationsShown', toggleData(action.options.mode))
+			},
+		},
+
+		mdsCue: {
+			name: 'Multidestination Studio - Cue',
+			description: 'Shows a cue in Preview, runs it, or stops the running cue',
+			options: [
+				{
+					type: 'dropdown',
+					id: 'mode',
+					label: 'Mode',
+					default: 'preview',
+					choices: [
+						{ id: 'preview', label: 'Cue to Preview' },
+						{ id: 'go', label: 'Run Cue' },
+						{ id: 'stop', label: 'Stop Cue' },
+					],
+					disableAutoExpression: true,
+				},
+				mdsDropdown('cue', 'Cue', state.cues, { isVisibleExpression: `$(options:mode) != 'stop'` }),
+			],
+			callback: async (action) => {
+				if (action.options.mode === 'stop') {
+					await multidestinationRequest(self, 'StopCue', {})
+				} else {
+					await multidestinationRequest(self, action.options.mode === 'go' ? 'GoCue' : 'SetPreviewCue', {
+						cueName: action.options.cue,
+					})
+				}
+			},
+		},
+	}
+}
