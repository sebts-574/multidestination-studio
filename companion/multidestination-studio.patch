+import { CompanionFeedbackDefinitions } from '@companion-module/base'
+import type OBSInstance from '../main.js'
+import { styleActive, stylePreview, styleProgram } from '../presets/style.js'
+import { mdsDropdown } from '../actions/multidestination.js'
+
+export type MultidestinationFeedbackSchemas = {
+	mdsScene: { type: 'boolean'; options: { scene: string; state: 'program' | 'preview' } }
+	mdsAfterTransition: { type: 'boolean'; options: Record<string, never> }
+	mdsDestinationsShown: { type: 'boolean'; options: Record<string, never> }
+	mdsCue: { type: 'boolean'; options: { cue: string; state: 'running' | 'preview' } }
+	mdsGroupSource: { type: 'boolean'; options: { group: string; source: string } }
+}
+
+export function getMultidestinationFeedbacks(
+	self: OBSInstance,
+): CompanionFeedbackDefinitions<MultidestinationFeedbackSchemas> {
+	const state = self.multidestination
+	return {
+		mdsScene: {
+			type: 'boolean',
+			name: 'Multidestination Studio - Scene in Preview / Program',
+			description: 'If a scene is in the Multidestination Studio Preview or Program, change the style of the button',
+			defaultStyle: styleProgram(),
+			options: [
+				mdsDropdown('scene', 'Scene', state.scenes),
+				{
+					type: 'dropdown',
+					id: 'state',
+					label: 'State',
+					default: 'program',
+					choices: [
+						{ id: 'program', label: 'Program' },
+						{ id: 'preview', label: 'Preview' },
+					],
+					disableAutoExpression: true,
+				},
+			],
+			callback: (feedback) => {
+				const mds = self.multidestination
+				const current = feedback.options.state === 'preview' ? mds.previewScene : mds.programScene
+				return self.multidestination.available && current === feedback.options.scene
+			},
+		},
+
+		mdsAfterTransition: {
+			type: 'boolean',
+			name: 'Multidestination Studio - Previous Program Returns to Preview',
+			description: 'If the previous Program returns to Preview after a transition, change the style of the button',
+			defaultStyle: styleActive(),
+			options: [],
+			callback: () => self.multidestination.available && self.multidestination.swapAfterTake,
+		},
+
+		mdsDestinationsShown: {
+			type: 'boolean',
+			name: 'Multidestination Studio - All Destinations Shown',
+			description:
+				'If every destination is shown (not only those of the selected scene), change the style of the button',
+			defaultStyle: styleActive(),
+			options: [],
+			callback: () => self.multidestination.available && self.multidestination.showAllDestinations,
+		},
+
+		mdsCue: {
+			type: 'boolean',
+			name: 'Multidestination Studio - Cue',
+			description: 'If a cue is in Preview or running, change the style of the button',
+			defaultStyle: stylePreview(),
+			options: [
+				mdsDropdown('cue', 'Cue', state.cues),
+				{
+					type: 'dropdown',
+					id: 'state',
+					label: 'State',
+					default: 'preview',
+					choices: [
+						{ id: 'preview', label: 'In Preview' },
+						{ id: 'running', label: 'Running' },
+					],
+					disableAutoExpression: true,
+				},
+			],
+			callback: (feedback) => {
+				const current =
+					feedback.options.state === 'running' ? self.multidestination.runningCue : self.multidestination.previewCue
+				return self.multidestination.available && current === feedback.options.cue
+			},
+		},
+
+		mdsGroupSource: {
+			type: 'boolean',
+			name: 'Multidestination Studio - Source Shown in Group',
+			description: 'If a source is the one shown in its group, change the style of the button',
+			defaultStyle: styleActive(),
+			options: [
+				mdsDropdown(
+					'group',
+					'Group',
+					state.groups.map((g) => g.name),
+				),
+				mdsDropdown('source', 'Source', [...new Set(state.groups.flatMap((g) => g.sources))]),
+			],
+			callback: (feedback) => {
+				const group = self.multidestination.groups.find((g) => g.name === feedback.options.group)
+				return self.multidestination.available && !!group && group.current === feedback.options.source
+			},
+		},
+	}
+}
